# Copy to .env.local for local dev overrides
# Unit CSV sources (optional; otherwise src/config/unit-config.json is used)
# VITE_MEMBERS_CSV_URL=
# VITE_REF_DATA_CSV_URL=
# VITE_OPS_CSV_URL=
# Deployment Netlify function path or full URL
# VITE_DEPLOYMENT_EXEC_URL=/.netlify/functions/gas

# Admin login (existing)
# VITE_ADMIN_PLAINPASS=
